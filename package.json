{
  "name": "ai-agent-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Personal AI Operating System and secure agent marketplace hub.",
  "workspaces": [
    "frontend",
    "backend-core"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --workspace backend-core run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace backend-core run prisma:generate --silent && npm --workspaces run build",
    "lint": "npm --workspaces run lint",
    "test": "npm --workspaces run test",
    "typecheck": "npm --workspaces run typecheck",
    "smoke:ui": "playwright test",
    "smoke:production": "npm --workspace backend-core run smoke:production",
    "verify:release": "npm --workspace backend-core run verify:release",
    "db:push": "npm --workspace backend-core run db:push",
    "db:seed": "npm --workspace backend-core run db:seed",
    "db:seed:sample": "npm --workspace backend-core run db:seed:sample",
    "db:cleanup:demo": "npm --workspace backend-core run db:cleanup:demo --"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "playwright": "^1.61.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
