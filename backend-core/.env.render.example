NODE_ENV=production
PORT=4141

# Supabase Postgres. Replace <YOUR_SUPABASE_DB_PASSWORD> before adding these to Render.
DATABASE_URL=postgresql://postgres.gpcdbncuoukyqdjblnhr:<YOUR_SUPABASE_DB_PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.gpcdbncuoukyqdjblnhr:<YOUR_SUPABASE_DB_PASSWORD>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Replace these with your deployed frontend URL before adding them to Render.
FRONTEND_ORIGIN=https://your-ai-agent-hub.pages.dev
APP_PUBLIC_URL=https://your-ai-agent-hub.pages.dev

VAULT_LOCAL_PATH=./vault-samples/personal-vault
VAULT_ENCRYPTION_KEY=<MAKE_A_RANDOM_32_PLUS_CHARACTER_SECRET>
SYNC_MODE=local
LOG_LEVEL=info
EMBEDDING_PROVIDER=local-hash
SUPABASE_URL=https://gpcdbncuoukyqdjblnhr.supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-PUBLISHABLE-KEY]

# Optional free email notifications for approval requests.
# Create a free Resend API key, then add it in Render env vars.
RESEND_API_KEY=[YOUR-RESEND-API-KEY]
NOTIFICATION_FROM_EMAIL="AI Agent Hub <onboarding@resend.dev>"

# Optional real LLM responses for connected agents.
OPENAI_API_KEY=[YOUR-OPENAI-API-KEY]
OPENAI_MODEL=gpt-4o-mini

# External marketplace helper proxy limits.
EXTERNAL_RUNTIME_TIMEOUT_MS=10000
EXTERNAL_RUNTIME_MAX_RESPONSE_BYTES=60000

# Backend exposes /health for liveness and /health/ready for a database
# readiness check. API rate limits are in-memory and appropriate for a single
# Render instance; use a shared limiter before horizontal scaling.
