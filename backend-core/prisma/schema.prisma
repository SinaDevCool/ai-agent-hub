generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AgentCategory {
  Financial
  Executive
  Wellness
  Domestic
  Legal
  Travel
  Maintenance
  Custom
}

enum ApiProtocol {
  OpenAPI
  MCP
}

enum PermissionType {
  read
  write
  execute_action
}

enum ConnectionStatus {
  active
  restricted
  revoked
}

enum ActivityActionType {
  agent_created
  agent_removed
  vault_read
  vault_write
  api_callback
  execution_triggered
  permission_requested
  hitl_requested
  hitl_approved
  hitl_denied
  indexing_completed
}

enum ActivityStatus {
  success
  blocked_by_policy
  pending_human_approval
  error
}

enum RiskLevel {
  low
  medium
  high
}

enum NotificationChannel {
  email
}

enum NotificationStatus {
  pending
  sent
  skipped
  failed
}

enum MarketplaceStatus {
  draft
  needs_review
  published
  archived
}

enum AgentMessageRole {
  user
  agent
  system
}

enum UserRole {
  user
  creator
  moderator
  admin
}

enum CreatorAccessRequestStatus {
  pending
  approved
  denied
}

enum ToolRunStatus {
  queued
  running
  waiting_for_approval
  succeeded
  failed
  blocked
  cancelled
}

enum AgentRunStatus {
  planning
  running
  waiting_for_permission
  waiting_for_approval
  succeeded
  failed
  blocked
  cancelled
}

enum AgentRunStepType {
  think
  ask_user
  request_permission
  call_tool
  wait_for_approval
  summarize
}

enum ConnectedAccountStatus {
  active
  refreshing
  expired
  revoked
  error
}

enum WorkflowConnectionStatus {
  draft
  active
  failed
  disabled
}

enum ProviderConnectionStatus {
  active
  refreshing
  expired
  reconnect_required
  revoked
  error
  disabled
}

enum DurableJobStatus {
  queued
  leased
  retry_scheduled
  reconciliation_required
  succeeded
  cancelled
  dead_letter
}

enum BetaInviteStatus {
  pending
  redeemed
  revoked
  expired
  replaced
}

enum DataRightsRequestType {
  export
  deletion
}

enum DataRightsRequestStatus {
  pending
  scheduled
  processing
  completed
  cancelled
  failed
}

model User {
  id                            String                 @id @default(cuid())
  email                         String                 @unique
  role                          UserRole               @default(user)
  vaultLocalPath                String                 @map("vault_local_path")
  vaultEncryptionSalt           String                 @map("vault_encryption_salt")
  createdAt                     DateTime               @default(now()) @map("created_at")
  creatorProfile                CreatorProfile?
  agentInstalls                 UserAgentInstall[]
  connections                   UserConnection[]
  permissions                   AgentPermission[]
  activityLogs                  ActivityLog[]
  vaultDocuments                VaultDocument[]
  hitlRequests                  HitlRequest[]
  notifications                 Notification[]
  conversations                 AgentConversation[]
  agentRuns                     AgentRun[]
  toolRuns                      ToolRun[]
  providerReceipts              ProviderReceipt[]
  providerConnections           ProviderConnection[]
  providerDefinitions           ProviderDefinition[]
  connectedAccounts             ConnectedAccount[]
  oauthAuthorizations           OAuthAuthorization[]
  workflowConnections           WorkflowConnection[]
  agentTraces                   AgentTrace[]
  lifeTransactions              LifeTransaction[]
  financialAccounts             FinancialAccount[]
  appointments                  Appointment[]
  shoppingLists                 ShoppingList[]
  creatorAccessRequests         CreatorAccessRequest[] @relation("CreatorAccessRequestUser")
  reviewedCreatorAccessRequests CreatorAccessRequest[] @relation("CreatorAccessRequestReviewer")
  durableJobs                   DurableJob[]
  sentBetaInvites               BetaInvite[]            @relation("BetaInviteInviter")
  redeemedBetaInvites           BetaInvite[]            @relation("BetaInviteRedeemer")
  betaFeedback                  BetaFeedback[]
  dataRightsRequests            DataRightsRequest[]
  betaTermsAcceptedAt           DateTime?                @map("beta_terms_accepted_at")
  onboardingState               String                   @default("{}") @map("onboarding_state")

  @@map("users")
}

model DataRightsRequest {
  id             String                  @id @default(cuid())
  userId         String                  @map("user_id")
  requestType    DataRightsRequestType   @map("request_type")
  status         DataRightsRequestStatus @default(pending)
  executeAfter   DateTime                @map("execute_after")
  completedAt    DateTime?               @map("completed_at")
  cancelledAt    DateTime?               @map("cancelled_at")
  failureReason  String?                 @map("failure_reason")
  artifactRef    String?                 @map("artifact_ref")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestType, status])
  @@index([status, executeAfter])
  @@map("data_rights_requests")
}

model BetaInvite {
  id               String           @id @default(cuid())
  tokenHash        String           @unique @map("token_hash")
  email            String
  cohort           String
  inviterUserId    String           @map("inviter_user_id")
  redeemedByUserId String?          @map("redeemed_by_user_id")
  status           BetaInviteStatus @default(pending)
  expiresAt        DateTime         @map("expires_at")
  redeemedAt       DateTime?        @map("redeemed_at")
  revokedAt        DateTime?        @map("revoked_at")
  replacedById     String?          @map("replaced_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  inviter          User             @relation("BetaInviteInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  redeemedBy       User?            @relation("BetaInviteRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([cohort, status])
  @@index([redeemedByUserId, status])
  @@map("beta_invites")
}

model BetaFeedback {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  category              String
  severity              String
  expectedResult        String   @map("expected_result")
  actualResult          String   @map("actual_result")
  consentedDiagnostics  String   @default("{}") @map("consented_diagnostics")
  contactPreference     String   @default("none") @map("contact_preference")
  requestId             String?  @map("request_id")
  runId                 String?  @map("run_id")
  transactionId         String?  @map("transaction_id")
  status                String   @default("open")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, severity, createdAt])
  @@index([userId, createdAt])
  @@index([transactionId])
  @@map("beta_feedback")
}

model DurableJob {
  id                      String           @id @default(cuid())
  jobType                 String           @map("job_type")
  jobVersion              Int              @default(1) @map("job_version")
  userId                  String?          @map("user_id")
  aggregateType           String?          @map("aggregate_type")
  aggregateId             String?          @map("aggregate_id")
  dedupeKey               String           @unique @map("dedupe_key")
  payload                 String
  status                  DurableJobStatus @default(queued)
  priority                Int              @default(100)
  scheduledAt             DateTime         @default(now()) @map("scheduled_at")
  attemptCount            Int              @default(0) @map("attempt_count")
  maxAttempts             Int              @default(5) @map("max_attempts")
  leaseOwner              String?          @map("lease_owner")
  leaseExpiresAt          DateTime?         @map("lease_expires_at")
  heartbeatAt             DateTime?         @map("heartbeat_at")
  lastErrorClassification String?          @map("last_error_classification")
  lastErrorMessage        String?          @map("last_error_message")
  correlationId           String?          @map("correlation_id")
  startedAt               DateTime?         @map("started_at")
  completedAt             DateTime?         @map("completed_at")
  deadLetteredAt          DateTime?         @map("dead_lettered_at")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  user                    User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt, priority])
  @@index([leaseExpiresAt, status])
  @@index([userId, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("durable_jobs")
}

model ShoppingList {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  itemsJson String   @default("[]") @map("items_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, updatedAt])
  @@map("shopping_lists")
}

model Appointment {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  providerId         String   @map("provider_id")
  externalProviderId String   @map("external_provider_id")
  providerName       String   @map("provider_name")
  specialty          String
  location           String
  startsAt           DateTime @map("starts_at")
  endsAt             DateTime @map("ends_at")
  timeZone           String   @default("UTC") @map("time_zone")
  status             String   @default("requested")
  confirmationCode   String?  @map("confirmation_code")
  calendarEventJson  String   @default("{}") @map("calendar_event_json")
  idempotencyKey     String   @map("idempotency_key")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status, startsAt])
  @@map("appointments")
}

model FinancialAccount {
  id                String                 @id @default(cuid())
  userId            String                 @map("user_id")
  providerId        String                 @map("provider_id")
  externalAccountId String                 @map("external_account_id")
  name              String
  type              String
  subtype           String?
  mask              String?
  currency          String                 @default("EUR")
  currentBalance    Float?                 @map("current_balance")
  availableBalance  Float?                 @map("available_balance")
  syncCursor        String?                @map("sync_cursor")
  dataFreshAt       DateTime?              @map("data_fresh_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      FinancialTransaction[]

  @@unique([userId, providerId, externalAccountId])
  @@index([userId, updatedAt])
  @@map("financial_accounts")
}

model FinancialTransaction {
  id                    String           @id @default(cuid())
  userId                String           @map("user_id")
  financialAccountId    String           @map("financial_account_id")
  providerTransactionId String           @map("provider_transaction_id")
  name                  String
  merchantName          String?          @map("merchant_name")
  amount                Float
  currency              String           @default("EUR")
  date                  DateTime
  pending               Boolean          @default(false)
  categoryPrimary       String?          @map("category_primary")
  categoryDetailed      String?          @map("category_detailed")
  removedAt             DateTime?        @map("removed_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  account               FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, providerTransactionId])
  @@index([userId, date])
  @@index([financialAccountId, date])
  @@map("financial_transactions")
}

model LifeTransaction {
  id                     String                       @id @default(cuid())
  userId                 String                       @map("user_id")
  capabilityKey          String                       @map("capability_key")
  executionLevel         String                       @map("execution_level")
  state                  String                       @default("draft")
  region                 String?
  providerId             String?                      @map("provider_id")
  providerCandidatesJson String                       @default("[]") @map("provider_candidates_json")
  approvalRequired       Boolean                      @default(false) @map("approval_required")
  hitlRequestId          String?                      @map("hitl_request_id")
  idempotencyKey         String                       @map("idempotency_key")
  inputJson              String                       @default("{}") @map("input_json")
  resultJson             String                       @default("{}") @map("result_json")
  externalReference      String?                      @map("external_reference")
  failureReason          String?                      @map("failure_reason")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  completedAt            DateTime?                    @map("completed_at")
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts               ProviderTransactionAttempt[]

  @@unique([userId, idempotencyKey])
  @@index([userId, state, createdAt])
  @@index([providerId, state])
  @@map("life_transactions")
}

model ProviderTransactionAttempt {
  id                String          @id @default(cuid())
  lifeTransactionId String          @map("life_transaction_id")
  providerId        String          @map("provider_id")
  action            String
  attemptNumber     Int             @map("attempt_number")
  status            String
  requestJson       String          @default("{}") @map("request_json")
  responseJson      String          @default("{}") @map("response_json")
  externalReference String?         @map("external_reference")
  failureCode       String?         @map("failure_code")
  failureMessage    String?         @map("failure_message")
  startedAt         DateTime        @default(now()) @map("started_at")
  completedAt       DateTime?       @map("completed_at")
  lifeTransaction   LifeTransaction @relation(fields: [lifeTransactionId], references: [id], onDelete: Cascade)

  @@unique([lifeTransactionId, attemptNumber])
  @@index([providerId, status, startedAt])
  @@map("provider_transaction_attempts")
}

model ProviderWebhookEvent {
  id              String    @id @default(cuid())
  providerId      String    @map("provider_id")
  externalEventId String    @map("external_event_id")
  eventType       String    @map("event_type")
  payloadJson     String    @default("{}") @map("payload_json")
  status          String    @default("received")
  failureReason   String?   @map("failure_reason")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")

  @@unique([providerId, externalEventId])
  @@index([status, receivedAt])
  @@map("provider_webhook_events")
}

model ProviderIdempotencyRecord {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  providerId        String   @map("provider_id")
  idempotencyKey    String   @map("idempotency_key")
  requestHash       String   @map("request_hash")
  status            String   @default("processing")
  responseJson      String   @default("{}") @map("response_json")
  externalReference String?  @map("external_reference")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([userId, providerId, idempotencyKey])
  @@index([expiresAt])
  @@map("provider_idempotency_records")
}

model ProviderDefinition {
  id                       String    @id @default(cuid())
  providerId               String    @unique @map("provider_id")
  label                    String
  kind                     String
  toolName                 String    @map("tool_name")
  description              String    @default("")
  capabilitiesJson         String    @default("[]") @map("capabilities_json")
  actionsJson              String    @default("[]") @map("actions_json")
  actionSchemasJson        String    @default("[]") @map("action_schemas_json")
  runtimeConfigJson        String    @default("{}") @map("runtime_config_json")
  credentialType           String    @default("none") @map("credential_type")
  credentialFieldsJson     String    @default("[]") @map("credential_fields_json")
  oauthConfigJson          String    @default("{}") @map("oauth_config_json")
  authType                 String    @default("none") @map("auth_type")
  riskLevel                String    @default("medium") @map("risk_level")
  requiresConnectedAccount Boolean   @default(false) @map("requires_connected_account")
  supportsHealthCheck      Boolean   @default(false) @map("supports_health_check")
  healthStatus             String    @default("unknown") @map("health_status")
  healthFailureCode        String?   @map("health_failure_code")
  healthFailureMessage     String?   @map("health_failure_message")
  healthCheckedAt          DateTime? @map("health_checked_at")
  healthLastSuccessAt      DateTime? @map("health_last_success_at")
  healthLastFailureAt      DateTime? @map("health_last_failure_at")
  status                   String    @default("draft")
  createdByUserId          String?   @map("created_by_user_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  createdBy                User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, kind])
  @@index([healthStatus, healthCheckedAt])
  @@index([createdByUserId, status])
  @@map("provider_definitions")
}

model CreatorAccessRequest {
  id               String                     @id @default(cuid())
  userId           String                     @map("user_id")
  status           CreatorAccessRequestStatus @default(pending)
  reason           String
  reviewNote       String                     @default("") @map("review_note")
  reviewedAt       DateTime?                  @map("reviewed_at")
  reviewedByUserId String?                    @map("reviewed_by_user_id")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  user             User                       @relation("CreatorAccessRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                      @relation("CreatorAccessRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("creator_access_requests")
}

model CreatorProfile {
  id               String            @id @default(cuid())
  userId           String            @unique @map("user_id")
  displayName      String            @map("display_name")
  bio              String            @default("")
  verified         Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentDefinitions AgentDefinition[]

  @@map("creator_profiles")
}

model AgentDefinition {
  id                   String             @id @default(cuid())
  creatorId            String?            @map("creator_id")
  slug                 String             @unique
  name                 String
  tagline              String
  description          String
  category             AgentCategory
  status               MarketplaceStatus  @default(published)
  trustScore           Int                @default(70) @map("trust_score")
  installCount         Int                @default(0) @map("install_count")
  averageRating        Float              @default(0) @map("average_rating")
  moderationNote       String             @default("") @map("moderation_note")
  submittedForReviewAt DateTime?          @map("submitted_for_review_at")
  reviewedAt           DateTime?          @map("reviewed_at")
  reviewedByUserId     String?            @map("reviewed_by_user_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  creator              CreatorProfile?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  versions             AgentVersion[]
  installs             UserAgentInstall[]

  @@index([status, category])
  @@index([status, trustScore])
  @@map("agent_definitions")
}

model AgentVersion {
  id                 String             @id @default(cuid())
  agentDefinitionId  String             @map("agent_definition_id")
  version            String             @default("1.0.0")
  apiProtocol        ApiProtocol        @map("api_protocol")
  capabilityManifest String             @map("capability_manifest")
  releaseNotes       String             @default("") @map("release_notes")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  agentDefinition    AgentDefinition    @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  installs           UserAgentInstall[]

  @@unique([agentDefinitionId, version])
  @@index([agentDefinitionId, isActive])
  @@map("agent_versions")
}

model UserAgentInstall {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  agentDefinitionId String           @map("agent_definition_id")
  agentVersionId    String           @map("agent_version_id")
  agentId           String?          @map("agent_id")
  displayName       String           @map("display_name")
  connectionStatus  ConnectionStatus @default(restricted) @map("connection_status")
  installedAt       DateTime         @default(now()) @map("installed_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentDefinition   AgentDefinition  @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  agentVersion      AgentVersion     @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  agent             Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([userId, agentDefinitionId])
  @@index([userId, connectionStatus])
  @@map("user_agent_installs")
}

model Agent {
  id                  String               @id @default(cuid())
  name                String
  category            AgentCategory
  apiProtocol         ApiProtocol          @map("api_protocol")
  trustScore          Int                  @default(70) @map("trust_score")
  capabilityManifest  String               @map("capability_manifest")
  installs            UserAgentInstall[]
  permissions         AgentPermission[]
  connections         UserConnection[]
  activityLogs        ActivityLog[]
  hitlRequests        HitlRequest[]
  conversations       AgentConversation[]
  agentRuns           AgentRun[]
  toolRuns            ToolRun[]
  providerReceipts    ProviderReceipt[]
  workflowConnections WorkflowConnection[]
  agentTraces         AgentTrace[]

  @@index([name])
  @@map("agents")
}

model AgentConversation {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  agentId   String         @map("agent_id")
  title     String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]

  @@index([userId, agentId, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String            @map("conversation_id")
  role           AgentMessageRole
  content        String
  status         ActivityStatus?
  intent         String?
  metadata       String            @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at")
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model AgentRun {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  agentId          String            @map("agent_id")
  conversationId   String?           @map("conversation_id")
  status           AgentRunStatus    @default(planning)
  intent           String
  userGoal         String            @map("user_goal")
  plan             String            @default("{}")
  result           String            @default("{}")
  error            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  completedAt      DateTime?         @map("completed_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent            Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  steps            AgentRunStep[]
  toolRuns         ToolRun[]
  providerReceipts ProviderReceipt[]
  traces           AgentTrace[]

  @@index([userId, agentId, createdAt])
  @@index([status, createdAt])
  @@map("agent_runs")
}

model AgentRunStep {
  id          String           @id @default(cuid())
  agentRunId  String           @map("agent_run_id")
  stepType    AgentRunStepType @map("step_type")
  status      ToolRunStatus    @default(queued)
  title       String
  input       String           @default("{}")
  output      String           @default("{}")
  error       String?
  toolRunId   String?          @map("tool_run_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  completedAt DateTime?        @map("completed_at")
  agentRun    AgentRun         @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId, createdAt])
  @@map("agent_run_steps")
}

model ToolRun {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  agentId          String            @map("agent_id")
  agentRunId       String?           @map("agent_run_id")
  toolName         String            @map("tool_name")
  input            String            @default("{}")
  status           ToolRunStatus     @default(queued)
  result           String            @default("{}")
  error            String?
  riskLevel        RiskLevel         @default(low) @map("risk_level")
  requiresApproval Boolean           @default(false) @map("requires_approval")
  hitlRequestId    String?           @map("hitl_request_id")
  idempotencyKey   String?           @map("idempotency_key")
  createdAt        DateTime          @default(now()) @map("created_at")
  startedAt        DateTime?         @map("started_at")
  completedAt      DateTime?         @map("completed_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent            Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentRun         AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  providerReceipts ProviderReceipt[]

  @@unique([userId, idempotencyKey])
  @@index([userId, agentId, createdAt])
  @@index([status, createdAt])
  @@index([toolName, createdAt])
  @@map("tool_runs")
}

model ProviderReceipt {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  agentId           String    @map("agent_id")
  agentRunId        String?   @map("agent_run_id")
  toolRunId         String?   @map("tool_run_id")
  providerId        String    @map("provider_id")
  providerLabel     String    @map("provider_label")
  capabilityKey     String    @map("capability_key")
  capabilityLabel   String    @map("capability_label")
  action            String
  status            String
  approvalRequired  Boolean   @default(false) @map("approval_required")
  hitlRequestId     String?   @map("hitl_request_id")
  resultQuality     String?   @map("result_quality")
  userMessage       String    @map("user_message")
  technicalMessage  String?   @map("technical_message")
  retryable         Boolean   @default(false)
  nextAction        String?   @map("next_action")
  itemCount         Int       @default(0) @map("item_count")
  externalRequestId String?   @map("external_request_id")
  endpointHost      String?   @map("endpoint_host")
  metadata          String    @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentRun          AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  toolRun           ToolRun?  @relation(fields: [toolRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, agentId, createdAt])
  @@index([userId, capabilityKey, createdAt])
  @@index([toolRunId])
  @@map("provider_receipts")
}

model ConnectedAccount {
  id                    String                 @id @default(cuid())
  userId                String                 @map("user_id")
  provider              String
  accountLabel          String                 @default("") @map("account_label")
  scopes                String                 @default("[]")
  encryptedAccessToken  String?                @map("encrypted_access_token")
  encryptedRefreshToken String?                @map("encrypted_refresh_token")
  expiresAt             DateTime?              @map("expires_at")
  refreshStartedAt      DateTime?              @map("refresh_started_at")
  lastRefreshAt         DateTime?              @map("last_refresh_at")
  status                ConnectedAccountStatus @default(active)
  lastError             String?                @map("last_error")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountLabel])
  @@index([userId, provider, status])
  @@map("connected_accounts")
}

model OAuthAuthorization {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  provider              String
  stateHash             String    @unique @map("state_hash")
  encryptedCodeVerifier String    @map("encrypted_code_verifier")
  requestedScopes       String    @default("[]") @map("requested_scopes")
  returnPath            String    @default("/settings") @map("return_path")
  expiresAt             DateTime  @map("expires_at")
  consumedAt            DateTime? @map("consumed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, expiresAt])
  @@map("oauth_authorizations")
}

model ProviderConnection {
  id                    String                   @id @default(cuid())
  userId                String                   @map("user_id")
  providerId            String                   @map("provider_id")
  providerKind          String                   @map("provider_kind")
  authType              String                   @map("auth_type")
  status                ProviderConnectionStatus @default(active)
  displayName           String                   @default("") @map("display_name")
  encryptedCredentials  String                   @map("encrypted_credentials")
  credentialFingerprint String                   @map("credential_fingerprint")
  expiresAt             DateTime?                @map("expires_at")
  refreshAfter          DateTime?                @map("refresh_after")
  externalAccountId     String?                  @map("external_account_id")
  externalAccountLabel  String?                  @map("external_account_label")
  scopes                String                   @default("[]")
  metadata              String                   @default("{}")
  lastValidatedAt       DateTime?                @map("last_validated_at")
  lastSuccessAt         DateTime?                @map("last_success_at")
  lastFailureAt         DateTime?                @map("last_failure_at")
  lastFailureReason     String?                  @map("last_failure_reason")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, providerId])
  @@index([userId, status])
  @@map("provider_connections")
}

model WorkflowConnection {
  id                String                   @id @default(cuid())
  userId            String                   @map("user_id")
  agentId           String?                  @map("agent_id")
  toolName          String                   @default("workflow.run") @map("tool_name")
  capabilityKey     String                   @default("general.research") @map("capability_key")
  description       String                   @default("")
  name              String
  provider          String                   @default("custom")
  endpointUrl       String                   @map("endpoint_url")
  encryptedSecret   String                   @map("encrypted_secret")
  status            WorkflowConnectionStatus @default(draft)
  lastTestedAt      DateTime?                @map("last_tested_at")
  lastSuccessAt     DateTime?                @map("last_success_at")
  lastFailureAt     DateTime?                @map("last_failure_at")
  lastFailureReason String?                  @map("last_failure_reason")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent             Agent?                   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, agentId, toolName])
  @@index([userId, capabilityKey, status])
  @@index([userId, agentId, capabilityKey])
  @@map("workflow_connections")
}

model AgentTrace {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  agentId       String    @map("agent_id")
  agentRunId    String?   @map("agent_run_id")
  provider      String
  model         String
  promptVersion String    @default("runtime-v1") @map("prompt_version")
  inputSummary  String    @default("") @map("input_summary")
  outputSummary String    @default("") @map("output_summary")
  toolCalls     String    @default("[]") @map("tool_calls")
  latencyMs     Int       @default(0) @map("latency_ms")
  tokenUsage    String    @default("{}") @map("token_usage")
  costUsd       Float     @default(0) @map("cost_usd")
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentRun      AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([userId, agentId, createdAt])
  @@index([agentRunId])
  @@map("agent_traces")
}

model VaultSchema {
  id                 String            @id @default(cuid())
  name               String            @unique
  description        String
  structuralTemplate String            @map("structural_template")
  permissions        AgentPermission[]
  documents          VaultDocument[]

  @@map("vault_schemas")
}

model AgentPermission {
  id               String         @id @default(cuid())
  userId           String?        @map("user_id")
  agentId          String         @map("agent_id")
  vaultSchemaId    String?        @map("vault_schema_id")
  permissionType   PermissionType @map("permission_type")
  restrictionRules String         @map("restriction_rules")
  expiresAt        DateTime?      @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent            Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  vaultSchema      VaultSchema?   @relation(fields: [vaultSchemaId], references: [id], onDelete: Cascade)

  @@index([userId, agentId, vaultSchemaId, permissionType])
  @@map("agent_permissions")
}

model UserConnection {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  agentId          String           @map("agent_id")
  connectionStatus ConnectionStatus @default(restricted) @map("connection_status")
  tokenExpiresAt   DateTime?        @map("token_expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent            Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@map("user_connections")
}

model VaultDocument {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  vaultSchemaId  String?      @map("vault_schema_id")
  title          String
  relativePath   String       @map("relative_path")
  contentHash    String       @map("content_hash")
  frontmatter    String
  excerpt        String
  vectorProvider String       @map("vector_provider")
  embedding      String
  indexedAt      DateTime     @default(now()) @map("indexed_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultSchema    VaultSchema? @relation(fields: [vaultSchemaId], references: [id], onDelete: SetNull)

  @@index([userId, vaultSchemaId])
  @@index([userId, relativePath])
  @@map("vault_documents")
}

model ActivityLog {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  agentId         String?            @map("agent_id")
  actionType      ActivityActionType @map("action_type")
  status          ActivityStatus
  dataAccessed    String?            @map("data_accessed")
  dynamicMetadata String             @map("dynamic_metadata")
  hash            String
  previousHash    String?            @map("previous_hash")
  createdAt       DateTime           @default(now()) @map("created_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent           Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId, agentId, createdAt])
  @@map("activity_logs")
}

model HitlRequest {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  agentId       String         @map("agent_id")
  actionName    String         @map("action_name")
  riskLevel     RiskLevel      @default(high) @map("risk_level")
  payload       String
  status        ActivityStatus @default(pending_human_approval)
  expiresAt     DateTime       @map("expires_at")
  decidedAt     DateTime?      @map("decided_at")
  continuedAt   DateTime?      @map("continued_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent         Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId, agentId, status])
  @@map("hitl_requests")
}

model Notification {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  hitlRequestId String?             @map("hitl_request_id")
  channel       NotificationChannel @default(email)
  status        NotificationStatus  @default(pending)
  subject       String
  provider      String?
  providerId    String?             @map("provider_id")
  errorMessage  String?             @map("error_message")
  sentAt        DateTime?           @map("sent_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  hitlRequest   HitlRequest?        @relation(fields: [hitlRequestId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([hitlRequestId])
  @@map("notifications")
}
