generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AgentCategory {
  Financial
  Executive
  Wellness
  Domestic
  Legal
  Travel
  Maintenance
  Custom
}

enum ApiProtocol {
  OpenAPI
  MCP
}

enum PermissionType {
  read
  write
  execute_action
}

enum ConnectionStatus {
  active
  restricted
  revoked
}

enum ActivityActionType {
  agent_created
  agent_removed
  vault_read
  vault_write
  api_callback
  execution_triggered
  permission_requested
  hitl_requested
  hitl_approved
  hitl_denied
  indexing_completed
}

enum ActivityStatus {
  success
  blocked_by_policy
  pending_human_approval
  error
}

enum RiskLevel {
  low
  medium
  high
}

enum NotificationChannel {
  email
}

enum NotificationStatus {
  pending
  sent
  skipped
  failed
}

enum MarketplaceStatus {
  draft
  needs_review
  published
  archived
}

enum AgentMessageRole {
  user
  agent
  system
}

enum UserRole {
  user
  creator
  moderator
  admin
}

enum CreatorAccessRequestStatus {
  pending
  approved
  denied
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  role                UserRole         @default(user)
  vaultLocalPath      String           @map("vault_local_path")
  vaultEncryptionSalt String           @map("vault_encryption_salt")
  createdAt           DateTime         @default(now()) @map("created_at")
  creatorProfile      CreatorProfile?
  agentInstalls       UserAgentInstall[]
  connections         UserConnection[]
  permissions         AgentPermission[]
  activityLogs        ActivityLog[]
  vaultDocuments      VaultDocument[]
  hitlRequests        HitlRequest[]
  notifications       Notification[]
  conversations       AgentConversation[]
  creatorAccessRequests CreatorAccessRequest[] @relation("CreatorAccessRequestUser")
  reviewedCreatorAccessRequests CreatorAccessRequest[] @relation("CreatorAccessRequestReviewer")

  @@map("users")
}

model CreatorAccessRequest {
  id               String                     @id @default(cuid())
  userId           String                     @map("user_id")
  status           CreatorAccessRequestStatus @default(pending)
  reason           String
  reviewNote       String                     @default("") @map("review_note")
  reviewedAt       DateTime?                  @map("reviewed_at")
  reviewedByUserId String?                    @map("reviewed_by_user_id")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  user             User                       @relation("CreatorAccessRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                      @relation("CreatorAccessRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("creator_access_requests")
}

model CreatorProfile {
  id               String            @id @default(cuid())
  userId           String            @unique @map("user_id")
  displayName      String            @map("display_name")
  bio              String            @default("")
  verified         Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentDefinitions AgentDefinition[]

  @@map("creator_profiles")
}

model AgentDefinition {
  id             String             @id @default(cuid())
  creatorId      String?            @map("creator_id")
  slug           String             @unique
  name           String
  tagline        String
  description    String
  category       AgentCategory
  status         MarketplaceStatus  @default(published)
  trustScore     Int                @default(70) @map("trust_score")
  installCount   Int                @default(0) @map("install_count")
  averageRating  Float              @default(0) @map("average_rating")
  moderationNote String             @default("") @map("moderation_note")
  submittedForReviewAt DateTime?    @map("submitted_for_review_at")
  reviewedAt     DateTime?          @map("reviewed_at")
  reviewedByUserId String?          @map("reviewed_by_user_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  creator        CreatorProfile?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  versions       AgentVersion[]
  installs       UserAgentInstall[]

  @@index([status, category])
  @@index([status, trustScore])
  @@map("agent_definitions")
}

model AgentVersion {
  id                String             @id @default(cuid())
  agentDefinitionId String             @map("agent_definition_id")
  version           String             @default("1.0.0")
  apiProtocol       ApiProtocol        @map("api_protocol")
  capabilityManifest String            @map("capability_manifest")
  releaseNotes      String             @default("") @map("release_notes")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  agentDefinition   AgentDefinition    @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  installs          UserAgentInstall[]

  @@unique([agentDefinitionId, version])
  @@index([agentDefinitionId, isActive])
  @@map("agent_versions")
}

model UserAgentInstall {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  agentDefinitionId String             @map("agent_definition_id")
  agentVersionId    String             @map("agent_version_id")
  agentId           String?            @map("agent_id")
  displayName       String             @map("display_name")
  connectionStatus  ConnectionStatus   @default(restricted) @map("connection_status")
  installedAt       DateTime           @default(now()) @map("installed_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentDefinition   AgentDefinition    @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  agentVersion      AgentVersion       @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  agent             Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([userId, agentDefinitionId])
  @@index([userId, connectionStatus])
  @@map("user_agent_installs")
}

model Agent {
  id                 String            @id @default(cuid())
  name               String
  category           AgentCategory
  apiProtocol        ApiProtocol        @map("api_protocol")
  trustScore         Int               @default(70) @map("trust_score")
  capabilityManifest String            @map("capability_manifest")
  installs           UserAgentInstall[]
  permissions        AgentPermission[]
  connections        UserConnection[]
  activityLogs       ActivityLog[]
  hitlRequests       HitlRequest[]
  conversations      AgentConversation[]

  @@index([name])
  @@map("agents")
}

model AgentConversation {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  agentId   String         @map("agent_id")
  title     String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]

  @@index([userId, agentId, updatedAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String            @map("conversation_id")
  role           AgentMessageRole
  content        String
  status         ActivityStatus?
  intent         String?
  metadata       String            @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at")
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model VaultSchema {
  id                 String            @id @default(cuid())
  name               String            @unique
  description        String
  structuralTemplate String            @map("structural_template")
  permissions        AgentPermission[]
  documents          VaultDocument[]

  @@map("vault_schemas")
}

model AgentPermission {
  id               String         @id @default(cuid())
  userId           String?        @map("user_id")
  agentId          String         @map("agent_id")
  vaultSchemaId    String?        @map("vault_schema_id")
  permissionType   PermissionType @map("permission_type")
  restrictionRules String         @map("restriction_rules")
  expiresAt        DateTime?      @map("expires_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent            Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  vaultSchema      VaultSchema?   @relation(fields: [vaultSchemaId], references: [id], onDelete: Cascade)

  @@index([userId, agentId, vaultSchemaId, permissionType])
  @@map("agent_permissions")
}

model UserConnection {
  id               String           @id @default(cuid())
  userId           String           @map("user_id")
  agentId          String           @map("agent_id")
  connectionStatus ConnectionStatus @default(restricted) @map("connection_status")
  tokenExpiresAt   DateTime?        @map("token_expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent            Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@map("user_connections")
}

model VaultDocument {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  vaultSchemaId  String?      @map("vault_schema_id")
  title          String
  relativePath   String       @map("relative_path")
  contentHash    String       @map("content_hash")
  frontmatter    String
  excerpt        String
  vectorProvider String       @map("vector_provider")
  embedding      String
  indexedAt      DateTime     @default(now()) @map("indexed_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultSchema    VaultSchema? @relation(fields: [vaultSchemaId], references: [id], onDelete: SetNull)

  @@index([userId, vaultSchemaId])
  @@index([userId, relativePath])
  @@map("vault_documents")
}

model ActivityLog {
  id              String             @id @default(cuid())
  userId          String             @map("user_id")
  agentId         String?            @map("agent_id")
  actionType      ActivityActionType @map("action_type")
  status          ActivityStatus
  dataAccessed    String?            @map("data_accessed")
  dynamicMetadata String             @map("dynamic_metadata")
  hash            String
  previousHash    String?            @map("previous_hash")
  createdAt       DateTime           @default(now()) @map("created_at")
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent           Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId, agentId, createdAt])
  @@map("activity_logs")
}

model HitlRequest {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  agentId        String         @map("agent_id")
  actionName     String         @map("action_name")
  riskLevel      RiskLevel      @default(high) @map("risk_level")
  payload        String
  status         ActivityStatus @default(pending_human_approval)
  expiresAt      DateTime       @map("expires_at")
  decidedAt      DateTime?      @map("decided_at")
  continuedAt    DateTime?      @map("continued_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([userId, agentId, status])
  @@map("hitl_requests")
}

model Notification {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  hitlRequestId String?             @map("hitl_request_id")
  channel       NotificationChannel @default(email)
  status        NotificationStatus  @default(pending)
  subject       String
  provider      String?
  providerId    String?             @map("provider_id")
  errorMessage  String?             @map("error_message")
  sentAt        DateTime?           @map("sent_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  hitlRequest   HitlRequest?        @relation(fields: [hitlRequestId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([hitlRequestId])
  @@map("notifications")
}
