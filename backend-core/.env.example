NODE_ENV=development
APP_ENV=local
RELEASE_SHA=development
MIGRATION_VERSION=0023_privacy_export_expiry
PORT=4141
DATABASE_URL="file:./dev.db"
# Hosted Postgres deploys use Supabase. Use the pooled URL for DATABASE_URL
# and the direct URL for DIRECT_URL.
DIRECT_URL=""
FRONTEND_ORIGIN=http://localhost:5173
VAULT_LOCAL_PATH="./vault-samples/personal-vault"
VAULT_ENCRYPTION_KEY="replace-with-32-plus-random-characters"
SYNC_MODE=local
LOG_LEVEL=info
EMBEDDING_PROVIDER=local-hash
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4141
FRONTEND_PUBLIC_URL=http://localhost:5173
# Optional: add a free Resend API key to email users when an approval is needed.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="AI Agent Hub <onboarding@resend.dev>"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4141/api/connectors/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4141/api/connectors/microsoft/callback
DURABLE_JOBS_ENABLED=false
DURABLE_JOB_BATCH_SIZE=10
DURABLE_JOB_LEASE_MS=60000
DURABLE_JOB_POLL_MS=2000
LIVE_TRAVEL_ENABLED=false
LIVE_APPOINTMENTS_ENABLED=false
APPOINTMENTS_PROVIDER_TIMEOUT_MS=10000
CALCOM_WEBHOOK_SECRET=
CALCOM_WEBHOOK_REPLAY_MINUTES=10
LIVE_FINANCE_ENABLED=false
FINANCE_PROVIDER_TIMEOUT_MS=10000
HOSTED_TRAVEL_CHECKOUT_ENABLED=false
TRAVEL_PROVIDER_TIMEOUT_MS=10000
TRAVEL_LAUNCH_REGIONS=DE,EU
TRAVEL_LAUNCH_CURRENCIES=EUR
TRAVEL_CHECKOUT_HOSTS=
PRIVATE_BETA_ENFORCED=false
PRIVACY_RIGHTS_ENABLED=false
PRIVACY_DELETION_GRACE_HOURS=168
PRIVACY_EXPORT_EXECUTOR_ENABLED=false
PRIVACY_EXPORT_PATH=./private-exports
PRIVACY_EXPORT_TTL_HOURS=24
VERTICAL_RELEASE_GATING_ENABLED=false
VERTICAL_RELEASE_RULES={}
OPS_ALERT_DEAD_LETTER_WARN=1
OPS_ALERT_RECONCILIATION_WARN=1
OPS_ALERT_OLDEST_JOB_MINUTES=15
OPS_ALERT_PROVIDER_FAILURES_15M=5
BETA_COHORT_LIMITS={"team":25,"trusted":5,"early":25,"expanded":100}
BETA_CAPABILITY_RULES={}
EXTERNAL_RUNTIME_TIMEOUT_MS=10000
EXTERNAL_RUNTIME_MAX_RESPONSE_BYTES=60000
# Production also enables in-memory API rate limits and exposes /health/ready
# for a cheap database readiness check. Keep limits conservative on one Render
# instance; use an external shared limiter before horizontal scaling.
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
