{
  "name": "backend-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:with-generate": "npm run prisma:generate --silent && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "smoke:production": "node scripts/smoke_production_backend.mjs",
    "test": "tsx --test src/**/*.test.ts",
    "test:with-generate": "npm run prisma:generate --silent && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push",
    "db:push:postgres": "prisma db push --schema prisma/postgres/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:migration:create:postgres": "prisma migrate dev --schema prisma/postgres/schema.prisma",
    "db:bootstrap": "python scripts/bootstrap_sqlite.py",
    "db:seed": "npm run prisma:generate --silent && tsx prisma/seed.ts",
    "db:seed:sample": "npm run prisma:generate --silent && tsx prisma/seed.ts --sample-user",
    "db:seed:postgres": "npm run prisma:generate:postgres --silent && tsx prisma/seed.ts",
    "db:cleanup:demo": "npm run prisma:generate --silent && tsx prisma/cleanup_demo_data.ts",
    "prisma:generate": "prisma generate",
    "prisma:generate:postgres": "prisma generate --schema prisma/postgres/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@supabase/supabase-js": "^2.110.0",
    "bcryptjs": "^2.4.3",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "gray-matter": "^4.0.3",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
