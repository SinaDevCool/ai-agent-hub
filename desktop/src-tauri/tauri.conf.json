{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Agent Hub",
  "version": "0.1.0",
  "identifier": "com.aiagenthub.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../frontend run build -- --mode desktop",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [{ "title": "AI Agent Hub", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https://*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["ai-agent-hub"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": ["../model-manifest.json", "binaries/*"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
